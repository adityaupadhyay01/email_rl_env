# Copy this file to .env and fill in what you need. Never commit .env.

# Where emails come from: local (data/fallback.json) or supabase
EMAIL_SOURCE=local

# Only needed when EMAIL_SOURCE=supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# Only needed for the LLM agent (python inference.py --agent llm)
HF_TOKEN=your_huggingface_token_here
API_BASE_URL=https://router.huggingface.co/v1
MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct

# Threat intelligence: live (real lookups, cached), cache (replay only), off
INTEL_MODE=live
# Optional extra URL reputation sources
GOOGLE_SAFE_BROWSING_KEY=
URLHAUS_AUTH_KEY=
# Only trust Authentication-Results headers added by your own mail server, e.g. mx.example.com
TRUSTED_AUTHSERV_ID=
